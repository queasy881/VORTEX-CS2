DATABASE_URL=postgresql://postgres:postgres@localhost:5432/p2p_share
JWT_ACCESS_SECRET=replace_with_long_random_string_at_least_32_chars
JWT_REFRESH_SECRET=replace_with_different_long_random_string_at_least_32_chars
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=p2p-share-files
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_PUBLIC_URL=
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
MAX_UPLOAD_SIZE_MB=2048
