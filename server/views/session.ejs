<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Emote Control — Session</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <!-- Navbar -->
  <nav class="navbar">
    <div class="navbar-inner">
      <a href="/dashboard" class="navbar-brand">
        <div class="logo-icon tiny">
          <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/>
          </svg>
        </div>
        <span>Emote Control</span>
      </a>
      <div class="navbar-right">
        <span class="navbar-user"><%= username %></span>
        <a href="/dashboard" class="btn btn-outline btn-sm">Back</a>
      </div>
    </div>
  </nav>

  <div class="page-container">
    <!-- Session Info Bar -->
    <div class="session-info-bar">
      <div class="session-info-left">
        <div class="status-badge status-<%= session.live_status %>">
          <span class="status-dot"></span>
          <span id="statusText"><%= session.live_status %></span>
        </div>
        <h1 id="machineName"><%= session.machine_name || 'Waiting for connection...' %></h1>
      </div>
      <div class="session-info-right">
        <div class="token-display" onclick="copyToken()">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/>
          </svg>
          <span><%= session.token.substring(0, 20) %>...</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="copy-icon">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/>
          </svg>
        </div>
      </div>
    </div>

    <!-- Quick Commands -->
    <div class="quick-commands">
      <button class="btn btn-outline btn-sm" onclick="sendQuick('screenshot')">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
        Screenshot
      </button>
      <button class="btn btn-outline btn-sm" onclick="sendQuick('sysinfo')">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
        System Info
      </button>
      <button class="btn btn-outline btn-sm" onclick="sendQuick('list_files', '.')">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 01-2 2H4a2 2 0 01-2-2V5a2 2 0 012-2h5l2 3h9a2 2 0 012 2z"/></svg>
        List Files
      </button>
      <button class="btn btn-outline btn-sm" onclick="promptCmd()">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>
        Run CMD
      </button>
      <button class="btn btn-outline btn-sm btn-live" id="liveScreenBtn" onclick="toggleLiveScreen()">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
        Live Screen
      </button>
    </div>

    <!-- Live Screen Viewer -->
    <div class="live-screen-container" id="liveScreenContainer" style="display:none;">
      <div class="live-screen-header">
        <div class="live-screen-title">
          <span class="live-dot"></span>
          <span>LIVE SCREEN</span>
        </div>
        <div class="live-screen-actions">
          <button class="btn btn-outline btn-sm" onclick="toggleLiveScreen()">Close</button>
        </div>
      </div>
      <div class="live-screen-viewport">
        <img id="liveScreenImg" alt="Live Screen" />
        <div class="live-screen-overlay" id="liveScreenOverlay">
          <div class="live-screen-connecting">
            <svg class="spin" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 11-6.219-8.56"/></svg>
            <span>Waiting for screen stream...</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Command Console -->
    <div class="command-console" id="console">
      <% if (commands.length === 0) { %>
        <div class="console-empty">
          <p>No commands yet. Use the buttons above or type below.</p>
        </div>
      <% } %>
      <% commands.forEach(cmd => { %>
        <div class="command-entry">
          <div class="cmd-header">
            <span class="cmd-name"><%= cmd.command %></span>
            <% if (cmd.args) { %><span class="cmd-args"><%= cmd.args %></span><% } %>
            <span class="cmd-status cmd-status-<%= cmd.status %>"><%= cmd.status %></span>
          </div>
          <% if (cmd.result) { %>
            <pre class="cmd-result"><%= cmd.result %></pre>
          <% } %>
        </div>
      <% }); %>
    </div>

    <!-- Command Input -->
    <div class="command-input-row">
      <div class="command-input-wrapper">
        <span class="cmd-prompt">$</span>
        <input type="text" id="cmdInput" placeholder="Type a command..." autocomplete="off">
      </div>
      <button class="btn btn-primary btn-send" onclick="sendCommand()">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/>
        </svg>
      </button>
    </div>

    <!-- Danger Zone -->
    <div class="danger-zone">
      <form method="POST" action="/session/<%= session.id %>/delete" onsubmit="return confirm('Delete this session and all its commands?')">
        <button type="submit" class="btn btn-danger btn-sm">Delete Session</button>
      </form>
    </div>
  </div>

  <div class="toast" id="toast"></div>

  <script>
    const sessionId = '<%= session.id %>';
    const fullToken = '<%= session.token %>';
    const cmdInput = document.getElementById('cmdInput');
    const consoleEl = document.getElementById('console');

    // Send command
    async function sendCommand() {
      const val = cmdInput.value.trim();
      if (!val) return;

      // Parse "command args" format
      const parts = val.split(' ');
      const command = parts[0];
      const args = parts.slice(1).join(' ') || null;

      cmdInput.value = '';

      try {
        const res = await fetch(`/session/${sessionId}/command`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ command, args }),
        });
        if (res.ok) pollStatus();
      } catch (err) {
        console.error(err);
      }
    }

    function sendQuick(command, args) {
      fetch(`/session/${sessionId}/command`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ command, args: args || null }),
      }).then(() => pollStatus());
    }

    function promptCmd() {
      cmdInput.value = 'cmd ';
      cmdInput.focus();
    }

    // Enter key sends
    cmdInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') sendCommand();
    });

    // Poll for updates
    async function pollStatus() {
      try {
        const res = await fetch(`/session/${sessionId}/status`);
        const data = await res.json();

        // Update status
        const badge = document.querySelector('.status-badge');
        const statusText = document.getElementById('statusText');
        const machineName = document.getElementById('machineName');

        badge.className = `status-badge status-${data.session.live_status}`;
        statusText.textContent = data.session.live_status;
        machineName.textContent = data.session.machine_name || 'Waiting for connection...';

        // Update console
        if (data.commands.length > 0) {
          consoleEl.innerHTML = data.commands.map(cmd => `
            <div class="command-entry">
              <div class="cmd-header">
                <span class="cmd-name">${cmd.command}</span>
                ${cmd.args ? `<span class="cmd-args">${cmd.args}</span>` : ''}
                <span class="cmd-status cmd-status-${cmd.status}">${cmd.status}</span>
              </div>
              ${cmd.result ? `<pre class="cmd-result">${escapeHtml(cmd.result)}</pre>` : ''}
            </div>
          `).join('');
          consoleEl.scrollTop = consoleEl.scrollHeight;
        }
      } catch (err) {
        console.error('Poll error:', err);
      }
    }

    function escapeHtml(text) {
      const d = document.createElement('div');
      d.textContent = text;
      return d.innerHTML;
    }

    function copyToken() {
      navigator.clipboard.writeText(fullToken);
      showToast('Token copied!');
    }

    function showToast(msg) {
      const toast = document.getElementById('toast');
      toast.textContent = msg;
      toast.classList.add('show');
      setTimeout(() => toast.classList.remove('show'), 2500);
    }

    // Poll every 3 seconds
    setInterval(pollStatus, 3000);

    // ===== Live Screen =====
    let liveScreenActive = false;
    let liveKeepAlive = null;

    function toggleLiveScreen() {
      if (liveScreenActive) {
        stopLiveScreen();
      } else {
        startLiveScreen();
      }
    }

    function startLiveScreen() {
      liveScreenActive = true;
      const container = document.getElementById('liveScreenContainer');
      const img = document.getElementById('liveScreenImg');
      const overlay = document.getElementById('liveScreenOverlay');
      const btn = document.getElementById('liveScreenBtn');

      container.style.display = 'block';
      overlay.style.display = 'flex';
      btn.classList.add('active');
      btn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg> Stop Live';

      // Tell server we want screen stream
      fetch(`/session/${sessionId}/screen/start`, { method: 'POST' });

      // Start MJPEG stream
      img.src = `/session/${sessionId}/screen/stream?t=${Date.now()}`;
      img.onload = function() {
        overlay.style.display = 'none';
      };
      img.onerror = function() {
        // MJPEG streams fire onerror on close, ignore if intentional
      };

      // Keep alive ping every 10s
      liveKeepAlive = setInterval(() => {
        fetch(`/session/${sessionId}/screen/start`, { method: 'POST' });
      }, 10000);
    }

    function stopLiveScreen() {
      liveScreenActive = false;
      const container = document.getElementById('liveScreenContainer');
      const img = document.getElementById('liveScreenImg');
      const btn = document.getElementById('liveScreenBtn');

      img.src = '';
      container.style.display = 'none';
      btn.classList.remove('active');
      btn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg> Live Screen';

      if (liveKeepAlive) clearInterval(liveKeepAlive);
      fetch(`/session/${sessionId}/screen/stop`, { method: 'POST' });
    }
  </script>
</body>
</html>
