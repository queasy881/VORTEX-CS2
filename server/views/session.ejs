<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Emote Control — <%= session.machine_name || 'Session' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
</head>
<body class="session-body">
  <!-- Navbar -->
  <nav class="navbar">
    <div class="navbar-inner">
      <a href="/dashboard" class="navbar-brand">
        <div class="logo-icon tiny">
          <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/>
          </svg>
        </div>
        <span>Emote Control</span>
      </a>
      <div class="navbar-right">
        <span class="navbar-user"><%= username %></span>
        <a href="/dashboard" class="btn btn-outline btn-sm">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
          Back
        </a>
      </div>
    </div>
  </nav>

  <div class="session-layout">
    <!-- Left: Session Info + Live Screen Toggle -->
    <aside class="session-sidebar">
      <!-- Machine Info Card -->
      <div class="sidebar-card machine-card">
        <div class="machine-header">
          <div class="machine-avatar">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/>
            </svg>
          </div>
          <div>
            <h2 id="machineName"><%= session.machine_name || 'Waiting...' %></h2>
            <div class="status-badge status-<%= session.live_status %>" id="statusBadge">
              <span class="status-dot"></span>
              <span id="statusText"><%= session.live_status %></span>
            </div>
          </div>
        </div>
        <div class="machine-details">
          <div class="detail-row">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
            <span class="detail-token" onclick="copyToken()"><%= session.token.substring(0, 16) %>...<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="copy-icon"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg></span>
          </div>
          <div class="detail-row">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span>Created <%= new Date(session.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></span>
          </div>
        </div>
      </div>

      <!-- Live Screen Toggle -->
      <div class="sidebar-card live-toggle-card" id="liveToggleCard">
        <div class="live-toggle-header" onclick="toggleLiveScreen()">
          <div class="live-toggle-left">
            <div class="live-toggle-icon" id="liveToggleIcon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
            </div>
            <div>
              <span class="live-toggle-label">Live Screen</span>
              <span class="live-toggle-sub" id="liveStatus">Click to start</span>
            </div>
          </div>
          <label class="toggle-switch" onclick="event.stopPropagation()">
            <input type="checkbox" id="liveToggle" onchange="toggleLiveScreen()">
            <span class="toggle-slider"></span>
          </label>
        </div>
        <div class="live-fps-bar" id="liveFpsBar" style="display:none;">
          <span class="live-indicator"><span class="live-dot-red"></span> LIVE</span>
          <span class="fps-counter" id="liveFps">0 FPS</span>
        </div>
      </div>

      <!-- Quick Actions -->
      <div class="sidebar-card">
        <h3 class="sidebar-title">Quick Actions</h3>
        <div class="quick-action-grid">
          <button class="quick-action" onclick="sendQuick('screenshot')" title="Screenshot">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
            <span>Screenshot</span>
          </button>
          <button class="quick-action" onclick="sendQuick('sysinfo')" title="System Info">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
            <span>Sysinfo</span>
          </button>
          <button class="quick-action" onclick="sendQuick('processes')" title="Processes">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><line x1="9" y1="1" x2="9" y2="4"/><line x1="15" y1="1" x2="15" y2="4"/><line x1="9" y1="20" x2="9" y2="23"/><line x1="15" y1="20" x2="15" y2="23"/></svg>
            <span>Processes</span>
          </button>
          <button class="quick-action" onclick="sendQuick('wifi')" title="WiFi Info">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12.55a11 11 0 0114.08 0"/><path d="M1.42 9a16 16 0 0121.16 0"/><path d="M8.53 16.11a6 6 0 016.95 0"/><line x1="12" y1="20" x2="12.01" y2="20"/></svg>
            <span>WiFi</span>
          </button>
          <button class="quick-action" onclick="sendQuick('list_files', '.')" title="List Files">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 01-2 2H4a2 2 0 01-2-2V5a2 2 0 012-2h5l2 3h9a2 2 0 012 2z"/></svg>
            <span>Files</span>
          </button>
          <button class="quick-action" onclick="sendQuick('drives')" title="Drives">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>
            <span>Drives</span>
          </button>
        </div>
      </div>

      <!-- Danger Zone -->
      <div class="sidebar-card danger-card">
        <form method="POST" action="/session/<%= session.id %>/delete" onsubmit="return confirm('Delete this session and all its commands?')">
          <button type="submit" class="btn btn-danger btn-sm" style="width:100%">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"/></svg>
            Delete Session
          </button>
        </form>
      </div>
    </aside>

    <!-- Right: Live Screen + Terminal -->
    <main class="session-main">
      <!-- Live Screen Panel (toggleable) -->
      <div class="live-panel" id="livePanel" style="display:none;">
        <div class="live-panel-header">
          <div class="live-panel-title">
            <span class="live-dot-red"></span>
            <span>LIVE SCREEN</span>
            <span class="live-fps-badge" id="liveFpsBadge">0 FPS</span>
          </div>
          <div style="display:flex;gap:8px;align-items:center;">
            <button class="btn-clip" id="clipBtn" onclick="clipLast30s()" title="Download last 30 seconds as MP4">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><line x1="20" y1="4" x2="8.12" y2="15.88"/><line x1="14.47" y1="14.48" x2="20" y2="20"/><line x1="8.12" y1="8.12" x2="12" y2="12"/></svg>
              <span>Clip 30s</span>
            </button>
            <button class="btn-icon" id="fullscreenBtn" onclick="toggleFullscreen()" title="Fullscreen">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 3 21 3 21 9"/><polyline points="9 21 3 21 3 15"/><line x1="21" y1="3" x2="14" y2="10"/><line x1="3" y1="21" x2="10" y2="14"/></svg>
            </button>
            <button class="btn-icon" onclick="toggleLiveScreen()" title="Close live screen">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
          </div>
        </div>
        <div class="live-panel-viewport">
          <canvas id="liveScreenCanvas"></canvas>
          <div class="live-panel-overlay" id="liveScreenOverlay">
            <div class="live-connecting">
              <svg class="spin" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 11-6.219-8.56"/></svg>
              <span>Connecting to screen stream...</span>
              <span class="live-connecting-sub">Make sure the agent is running</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Command Terminal -->
      <div class="terminal-card">
        <div class="terminal-header">
          <div class="terminal-dots">
            <span class="tdot red"></span>
            <span class="tdot yellow"></span>
            <span class="tdot green"></span>
          </div>
          <span class="terminal-title">Command Terminal</span>
          <span class="terminal-session-id">#<%= session.id %></span>
        </div>
        <div class="terminal-body" id="console">
          <% if (commands.length === 0) { %>
            <div class="terminal-welcome">
              <div class="terminal-welcome-icon">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>
              </div>
              <p>No commands yet</p>
              <span>Use quick actions or type a command below</span>
            </div>
          <% } else { %>
            <% commands.forEach(cmd => { %>
              <div class="command-entry">
                <div class="cmd-header">
                  <span class="cmd-prompt-icon">$</span>
                  <span class="cmd-name"><%= cmd.command %></span>
                  <% if (cmd.args) { %><span class="cmd-args"><%= cmd.args %></span><% } %>
                  <span class="cmd-status cmd-status-<%= cmd.status %>"><%= cmd.status %></span>
                </div>
                <% if (cmd.result) { %>
                  <pre class="cmd-result"><%= cmd.result %></pre>
                <% } %>
              </div>
            <% }); %>
          <% } %>
        </div>
        <div class="terminal-input-row">
          <span class="terminal-input-prompt">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="4 17 10 11 4 5"/></svg>
          </span>
          <input type="text" id="cmdInput" placeholder="Type a command... (try 'help')" autocomplete="off">
          <button class="btn-terminal-send" onclick="sendCommand()">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
          </button>
        </div>
      </div>
    </main>
  </div>

  <div class="toast" id="toast"></div>

  <script>
    const sessionId = '<%= session.id %>';
    const fullToken = '<%= session.token %>';
    const cmdInput = document.getElementById('cmdInput');
    const consoleEl = document.getElementById('console');

    // Send command
    async function sendCommand() {
      const val = cmdInput.value.trim();
      if (!val) return;
      const parts = val.split(' ');
      const command = parts[0];
      const args = parts.slice(1).join(' ') || null;
      cmdInput.value = '';
      try {
        const res = await fetch(`/session/${sessionId}/command`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ command, args }),
        });
        if (res.ok) pollStatus();
      } catch (err) { console.error(err); }
    }

    function sendQuick(command, args) {
      fetch(`/session/${sessionId}/command`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ command, args: args || null }),
      }).then(() => pollStatus());
    }

    cmdInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') sendCommand();
    });

    let lastPollHash = '';

    async function pollStatus() {
      try {
        const res = await fetch(`/session/${sessionId}/status`);
        const data = await res.json();
        const badge = document.getElementById('statusBadge');
        const statusText = document.getElementById('statusText');
        const machineName = document.getElementById('machineName');
        badge.className = `status-badge status-${data.session.live_status}`;
        statusText.textContent = data.session.live_status;
        machineName.textContent = data.session.machine_name || 'Waiting...';

        // Only re-render console if data actually changed
        const hash = JSON.stringify(data.commands.map(c => c.id + c.status + (c.result||'').length));
        if (hash !== lastPollHash && data.commands.length > 0) {
          lastPollHash = hash;
          consoleEl.innerHTML = data.commands.map(cmd => `
            <div class="command-entry">
              <div class="cmd-header">
                <span class="cmd-prompt-icon">$</span>
                <span class="cmd-name">${cmd.command}</span>
                ${cmd.args ? `<span class="cmd-args">${cmd.args}</span>` : ''}
                <span class="cmd-status cmd-status-${cmd.status}">${cmd.status}</span>
              </div>
              ${cmd.result ? `<pre class="cmd-result">${escapeHtml(cmd.result)}</pre>` : ''}
            </div>
          `).join('');
          consoleEl.scrollTop = consoleEl.scrollHeight;
        }
      } catch (err) { console.error('Poll error:', err); }
    }

    function escapeHtml(text) {
      const d = document.createElement('div');
      d.textContent = text;
      return d.innerHTML;
    }

    function copyToken() {
      navigator.clipboard.writeText(fullToken);
      showToast('Token copied!');
    }

    function showToast(msg) {
      const toast = document.getElementById('toast');
      toast.textContent = msg;
      toast.classList.add('show');
      setTimeout(() => toast.classList.remove('show'), 2500);
    }

    setInterval(pollStatus, 3000);

    // ===== Live Screen (WebSocket) =====
    let liveScreenActive = false;
    let screenWs = null;
    let liveKeepAlive = null;
    let frameCount = 0;
    let fpsInterval = null;

    function toggleLiveScreen() {
      if (liveScreenActive) {
        stopLiveScreen();
      } else {
        startLiveScreen();
      }
    }

    function startLiveScreen() {
      liveScreenActive = true;
      const panel = document.getElementById('livePanel');
      const canvas = document.getElementById('liveScreenCanvas');
      const ctx = canvas.getContext('2d');
      const overlay = document.getElementById('liveScreenOverlay');
      const toggle = document.getElementById('liveToggle');
      const toggleCard = document.getElementById('liveToggleCard');
      const fpsBar = document.getElementById('liveFpsBar');
      const liveStatus = document.getElementById('liveStatus');
      const toggleIcon = document.getElementById('liveToggleIcon');

      panel.style.display = 'block';
      overlay.style.display = 'flex';
      toggle.checked = true;
      toggleCard.classList.add('active');
      fpsBar.style.display = 'flex';
      liveStatus.textContent = 'Connecting...';
      toggleIcon.classList.add('active');

      fetch(`/session/${sessionId}/screen/start`, { method: 'POST' });

      const wsProto = location.protocol === 'https:' ? 'wss:' : 'ws:';
      screenWs = new WebSocket(`${wsProto}//${location.host}?role=dashboard&session=${sessionId}`);
      screenWs.binaryType = 'arraybuffer';

      screenWs.onopen = () => { liveStatus.textContent = 'Connected — streaming'; };

      screenWs.onmessage = function(event) {
        if (!(event.data instanceof ArrayBuffer)) return;
        const blob = new Blob([event.data], { type: 'image/jpeg' });
        const url = URL.createObjectURL(blob);
        const img = new Image();
        img.onload = function() {
          if (canvas.width !== img.width || canvas.height !== img.height) {
            canvas.width = img.width;
            canvas.height = img.height;
          }
          ctx.drawImage(img, 0, 0);
          URL.revokeObjectURL(url);
          overlay.style.display = 'none';
        };
        img.src = url;
        frameCount++;
      };

      screenWs.onclose = function() {
        if (liveScreenActive) {
          liveStatus.textContent = 'Reconnecting...';
          setTimeout(() => { if (liveScreenActive) startLiveScreen(); }, 2000);
        }
      };

      frameCount = 0;
      fpsInterval = setInterval(() => {
        const fps = frameCount;
        document.getElementById('liveFps').textContent = fps + ' FPS';
        document.getElementById('liveFpsBadge').textContent = fps + ' FPS';
        frameCount = 0;
      }, 1000);

      liveKeepAlive = setInterval(() => {
        if (screenWs && screenWs.readyState === 1) screenWs.send('keepalive');
        fetch(`/session/${sessionId}/screen/start`, { method: 'POST' });
      }, 10000);
    }

    function stopLiveScreen() {
      liveScreenActive = false;
      const panel = document.getElementById('livePanel');
      const toggle = document.getElementById('liveToggle');
      const toggleCard = document.getElementById('liveToggleCard');
      const fpsBar = document.getElementById('liveFpsBar');
      const liveStatus = document.getElementById('liveStatus');
      const toggleIcon = document.getElementById('liveToggleIcon');

      if (screenWs) { screenWs.close(); screenWs = null; }
      panel.style.display = 'none';
      toggle.checked = false;
      toggleCard.classList.remove('active');
      fpsBar.style.display = 'none';
      liveStatus.textContent = 'Click to start';
      toggleIcon.classList.remove('active');

      if (liveKeepAlive) clearInterval(liveKeepAlive);
      if (fpsInterval) clearInterval(fpsInterval);
      fetch(`/session/${sessionId}/screen/stop`, { method: 'POST' });
    }

    // ===== Clip last 30 seconds =====
    async function clipLast30s() {
      const btn = document.getElementById('clipBtn');
      const origHtml = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = '<svg class="spin" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 11-6.219-8.56"/></svg><span>Creating...</span>';

      try {
        const res = await fetch(`/session/${sessionId}/screen/clip`, { method: 'POST' });
        if (!res.ok) {
          const err = await res.json().catch(() => ({ error: 'Failed' }));
          showToast(err.error || 'Clip failed');
          return;
        }
        // Download the MP4
        const blob = await res.blob();
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        const disp = res.headers.get('Content-Disposition') || '';
        const match = disp.match(/filename="(.+?)"/);
        a.download = match ? match[1] : `clip-${sessionId}.mp4`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
        showToast('Clip downloaded!');
      } catch (err) {
        console.error('Clip error:', err);
        showToast('Clip failed — check console');
      } finally {
        btn.disabled = false;
        btn.innerHTML = origHtml;
      }
    }

    // ===== Fullscreen =====
    function toggleFullscreen() {
      const panel = document.getElementById('livePanel');
      if (!document.fullscreenElement) {
        panel.requestFullscreen().catch(() => {});
      } else {
        document.exitFullscreen();
      }
    }

    document.addEventListener('fullscreenchange', () => {
      const btn = document.getElementById('fullscreenBtn');
      if (document.fullscreenElement) {
        btn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="4 14 10 14 10 20"/><polyline points="20 10 14 10 14 4"/><line x1="14" y1="10" x2="21" y2="3"/><line x1="3" y1="21" x2="10" y2="14"/></svg>';
        btn.title = 'Exit Fullscreen';
      } else {
        btn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 3 21 3 21 9"/><polyline points="9 21 3 21 3 15"/><line x1="21" y1="3" x2="14" y2="10"/><line x1="3" y1="21" x2="10" y2="14"/></svg>';
        btn.title = 'Fullscreen';
      }
    });

    // Auto-focus command input
    cmdInput.focus();
  </script>
</body>
</html>
