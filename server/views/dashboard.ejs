<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Emote Control — Dashboard</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <!-- Navbar -->
  <nav class="navbar">
    <div class="navbar-inner">
      <a href="/dashboard" class="navbar-brand">
        <div class="logo-icon tiny">
          <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/>
          </svg>
        </div>
        <span>Emote Control</span>
      </a>
      <div class="navbar-right">
        <span class="navbar-user">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          <%= username %>
        </span>
        <a href="/logout" class="btn btn-outline btn-sm">Logout</a>
      </div>
    </div>
  </nav>

  <!-- Content -->
  <div class="page-container">
    <!-- Stats Bar -->
    <div class="dash-stats">
      <div class="dash-stat">
        <div class="dash-stat-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
        </div>
        <div>
          <span class="dash-stat-value"><%= sessions.length %></span>
          <span class="dash-stat-label">Total Sessions</span>
        </div>
      </div>
      <div class="dash-stat">
        <div class="dash-stat-icon online">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        </div>
        <div>
          <span class="dash-stat-value"><%= sessions.filter(s => s.live_status === 'online').length %></span>
          <span class="dash-stat-label">Online Now</span>
        </div>
      </div>
      <div class="dash-stat">
        <div class="dash-stat-icon offline">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
        </div>
        <div>
          <span class="dash-stat-value"><%= sessions.filter(s => s.live_status === 'offline').length %></span>
          <span class="dash-stat-label">Offline</span>
        </div>
      </div>
    </div>

    <div class="page-header">
      <div>
        <h1>Sessions</h1>
        <p class="page-subtitle">Sessions are created automatically when the agent connects</p>
      </div>
    </div>

    <% if (sessions.length === 0) { %>
      <div class="empty-state-large">
        <div class="empty-icon">
          <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="#3a3a44" stroke-width="1.5">
            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/>
          </svg>
        </div>
        <h2>No sessions yet</h2>
        <p>Send the agent to a client and it will appear here</p>
      </div>
    <% } else { %>
      <div class="dashboard-grid">
        <% sessions.forEach((s, i) => { %>
          <div class="session-card-wrapper" style="animation-delay: <%= i * 50 %>ms">
            <a href="/session/<%= s.id %>" class="session-card">
              <div class="session-card-header">
                <div class="status-badge status-<%= s.live_status %>">
                  <span class="status-dot"></span>
                  <%= s.live_status %>
                </div>
                <span class="session-time"><%= new Date(s.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %></span>
              </div>
              <div class="session-card-body">
                <div class="session-machine">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                  <span><%= s.machine_name || 'Waiting for connection...' %></span>
                </div>
                <div class="session-token-preview">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
                  <span><%= s.token.substring(0, 16) %>...</span>
                </div>
              </div>
              <div class="session-card-footer">
                <% if (s.live_status === 'online') { %>
                  <span class="last-seen">Last seen just now</span>
                <% } else if (s.live_status === 'pending') { %>
                  <span class="last-seen">Awaiting connection</span>
                <% } else { %>
                  <span class="last-seen">Last seen <%= new Date(s.last_seen).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %></span>
                <% } %>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
              </div>
            </a>
            <form method="POST" action="/session/<%= s.id %>/delete" class="session-delete-form" onsubmit="return confirm('Delete this session?')">
              <button type="submit" class="btn-delete-session" title="Delete session">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
              </button>
            </form>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>
</body>
</html>
