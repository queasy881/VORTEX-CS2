<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Emote Control — Dashboard</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <!-- Navbar -->
  <nav class="navbar">
    <div class="navbar-inner">
      <a href="/dashboard" class="navbar-brand">
        <div class="logo-icon tiny">
          <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/>
          </svg>
        </div>
        <span>Emote Control</span>
      </a>
      <div class="navbar-right">
        <span class="navbar-user">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/>
          </svg>
          <%= username %>
        </span>
        <a href="/logout" class="btn btn-outline btn-sm">Logout</a>
      </div>
    </div>
  </nav>

  <!-- Content -->
  <div class="page-container">
    <div class="page-header">
      <div>
        <h1>Your Sessions</h1>
        <p class="page-subtitle"><%= sessions.length %> session<%= sessions.length !== 1 ? 's' : '' %></p>
      </div>
      <span class="page-subtitle" style="color:var(--text-secondary);font-size:13px;">Sessions are created automatically when the EXE connects</span>
    </div>

    <% if (sessions.length === 0) { %>
      <div class="empty-state-large">
        <div class="empty-icon">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#444" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/>
          </svg>
        </div>
        <h2>No sessions yet</h2>
        <p>Start a new session to remotely control your PC</p>
      </div>
    <% } else { %>
      <div class="dashboard-grid">
        <% sessions.forEach(s => { %>
          <div class="session-card-wrapper">
            <a href="/session/<%= s.id %>" class="session-card">
              <div class="session-card-header">
                <div class="status-badge status-<%= s.live_status %>">
                  <span class="status-dot"></span>
                  <%= s.live_status %>
                </div>
                <span class="session-time"><%= new Date(s.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %></span>
              </div>
              <div class="session-card-body">
                <div class="session-machine">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/>
                  </svg>
                  <span><%= s.machine_name || 'Waiting for connection...' %></span>
                </div>
                <div class="session-token-preview">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/>
                  </svg>
                  <span><%= s.token.substring(0, 16) %>...</span>
                </div>
              </div>
              <div class="session-card-footer">
                <% if (s.live_status === 'online') { %>
                  <span class="last-seen">Last seen just now</span>
                <% } else if (s.live_status === 'pending') { %>
                  <span class="last-seen">Awaiting connection</span>
                <% } else { %>
                  <span class="last-seen">Last seen <%= new Date(s.last_seen).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %></span>
                <% } %>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="9 18 15 12 9 6"/>
                </svg>
              </div>
            </a>
            <form method="POST" action="/session/<%= s.id %>/delete" class="session-delete-form" onsubmit="return confirm('Delete this session?')">
              <button type="submit" class="btn-delete-session" title="Delete session">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                </svg>
              </button>
            </form>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>
</body>
</html>
